# ssh-tunnel 配置示例
# 复制到 ~/.config/ssh-tunnel/config.yaml 后修改（首次在 App 里保存也会自动生成）
#
# 一个文件可以放多条连接，App 顶部下拉在它们之间切换；
# active 指向当前选中的那一条，同一时刻只有它在连接。

active: "公司"

# defaults 是所有连接共用的默认值，只放跟“连的是哪台服务器”无关、
# 大概率所有连接都一样的字段：chromePath（本机 Chrome 装哪了）、
# customDNS（习惯统一用的 DNS）。
#
# 某条连接自己填了同名字段就用自己的，留空才回退到这里；
# 这里也留空的话，走各字段自身的默认值（如 customDNS 留空=服务器解析）。
# 不适合放这里的字段：serverAddr/username/password/privateKey/serverPort/
# localPort/autoConnect ——它们恰恰是用来区分各条连接的，写这里没有意义。
defaults:
  chromePath: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  customDNS: ""

connections:
  - name: "公司"                      # 下拉里显示的名字，同一文件内唯一
    username: "user"                  # 服务器用户名
    password: ""                      # 服务器密码；与 privateKey 至少填一个
    privateKey: "~/.ssh/id_rsa"       # 私钥路径，支持 ~；与 password 同时填写时优先用私钥
    serverAddr: "example.com"         # 服务器地址
    serverPort: "22"                  # 服务器端口，留空默认 22
    localPort: "1081"                 # 本地 socks5 端口，留空默认 1081
    # customDNS 这里不写，跟着 defaults 走（服务器解析）
    useChrome: true                   # 是否同时启动本地 Chrome
    # chromePath 这里不写，跟着 defaults 走
    autoConnect: true                 # 打开 App 后自动连接这条

  # 多条连接建议用不同的 localPort，切换时浏览器里不必改代理地址
  - name: "家里"
    username: "user"
    password: "..."
    serverAddr: "home.example.com"
    serverPort: "22"
    localPort: "1082"
    useChrome: false
    autoConnect: false

  # 这条自己填了 chromePath，会覆盖 defaults 里的值——两者不冲突
  - name: "海外"
    username: "user"
    password: "..."
    serverAddr: "sg.example.com"
    localPort: "1083"
    chromePath: "/Applications/Google Chrome Beta.app/Contents/MacOS/Google Chrome Beta"
    useChrome: true
    autoConnect: false
